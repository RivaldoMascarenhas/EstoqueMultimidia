datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS (ESTOQUE & OPERAÇÃO)
// ----------------------------------------------------

enum Role {
  ADMIN
  GESTOR
  OPERADOR
  CONSULTA
  ACADEMIC_SUPPORT
}

enum ItemType {
  MATERIAL        // Material em quantidade (Cabos, Adaptadores, Pilhas)
  ASSET_EQUIPMENT // Equipamento individual rastreado por patrimônio (Projetor, Notebook)
}

enum ItemLogisticsType {
  FIXED_IN_ROOM   // Já instalado na sala (ex: Datashow fixo / Projetor de teto)
  MOBILE_STOCK    // Retirado do estoque físico e levado até a sala (ex: Notebook, Datashow móvel)
}

enum ResourceType {
  FIXED_IN_ROOM   // Infraestrutura Fixa instalada na sala (Datashow da sala, PC da sala, Áudio fixo)
  MOBILE_ASSET    // Equipamento Móvel Patrimonial (Notebook, Datashow móvel, Caixa de som, Microfone)
  QUANTITATIVE    // Item Quantitativo controlado por quantidade (HDMI, Adaptador, Cabos)
}

enum TaskType {
  FIXED_EQUIPMENT // Ligar Datashow fixo, testar imagem/áudio da sala
  SEPARATION      // Separar Notebook, Cabo HDMI, Caixa de som no armário
  DELIVERY        // Levar equipamentos para a sala
  COLLECTION      // Recolher equipamentos após o término da aula
  CUSTOM          // Tarefa personalizada
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum RequestPriority {
  NORMAL
  ALTA
  URGENTE
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum RequestStatus {
  AGENDADO
  EM_PREPARACAO
  PREPARADO
  EM_ATENDIMENTO
  FINALIZADO
  CANCELADO
  PROBLEMA
}

enum RequestOrigin {
  MANUAL           // Criado pelo formulário do Apoio Acadêmico
  IMPORTADO_LEGADO // Migrado do Google Calendar antigo
}

enum AssetStatus {
  AVAILABLE       // Disponível no armário/estoque
  IN_USE          // Em uso / Alocado fixo em sala de aula
  LOANED          // Emprestado
  IN_MAINTENANCE  // Em manutenção
  DAMAGED         // Danificado
  WRITTEN_OFF     // Baixado / Descartado
  LOST            // Perdido
}

enum MovementType {
  ENTRY           // Entrada
  EXIT            // Saída
  TRANSFER        // Transferência entre caixas
  LOAN            // Empréstimo
  RETURN          // Devolução
  MAINTENANCE_IN  // Envio para manutenção
  MAINTENANCE_OUT // Retorno da manutenção
  ADJUSTMENT      // Ajuste de inventário
  ASSET_REGISTER  // Cadastro inicial de patrimônio
  WRITE_OFF       // Baixa definitiva
}

enum LoanStatus {
  ACTIVE          // Em andamento
  RETURNED        // Devolvido normalmente
  OVERDUE         // Atrasado
  RETURNED_DAMAGED // Devolvido com avaria
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ----------------------------------------------------
// ENUMS (EVENTOS, BIOMETRIA & SORTEIOS)
// ----------------------------------------------------

enum EventStatus {
  DRAFT
  OPEN
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PrizeStatus {
  AVAILABLE
  DRAWING
  DRAWN
  DELIVERED
  CANCELLED
}

enum ParticipantStatus {
  ACTIVE
  REGISTERED
  CONFIRMED
  WAITLIST
  INACTIVE
  CANCELLED
}

enum PresenceMethod {
  FACE
  MANUAL
  QR_CODE
}

enum DrawType {
  PERSON
  RANGE
}

// ----------------------------------------------------
// USUÁRIOS E AUTORIZAÇÃO (SISTEMA MULTIMÍDIA)
// ----------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(OPERADOR)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  avatarUrl          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  movements          StockMovement[]
  loansCreated       Loan[]            @relation("LoanCreator")
  loansReceived      Loan[]            @relation("LoanReceiver")
  maintenances       Maintenance[]     @relation("MaintenanceCreator")
  maintenancesClosed Maintenance[]     @relation("MaintenanceCloser")
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]
  requestsCreated    Request[]         @relation("RequestCreatedBy")
  requestsAssigned   Request[]         @relation("RequestAssignedUser")
  tasksCompleted     RequestTask[]

  // Relações com Eventos e Sorteios
  presencesOperated  Presence[]        @relation("PresenceOperator")
  drawsOperated      Draw[]            @relation("DrawOperator")
  prizesDelivered    Winner[]          @relation("PrizeDeliveryOperator")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String
  role        Role      @default(OPERADOR)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([keyHash])
}

// ----------------------------------------------------
// DOMÍNIO CENTRAL DE PESSOAS FÍSICAS (UNIFICADO)
// ----------------------------------------------------

model Person {
  id           String    @id @default(cuid())
  name         String
  cpf          String?   @unique
  registration String?   @unique // Matrícula institucional / código acadêmico
  email        String?
  phone        String?
  photoUrl     String?
  category     String?   // Aluno, Professor, Técnico, Convidado, etc.
  affiliation  String?   // Curso / Departamento / Filiação institucional
  active       Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  faceEmbeddings FaceEmbedding[]
  participations EventParticipant[]
  presences      Presence[]
  drawsWon       Winner[]

  @@index([name])
  @@index([registration])
  @@index([cpf])
  @@index([email])
  @@index([active])
}

// ----------------------------------------------------
// BIOMETRIA FACIAL (FACE EMBEDDINGS)
// ----------------------------------------------------

model FaceEmbedding {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  model     String                          @default("dlib_face_recognition")
  embedding Unsupported("vector(128)")?
  active    Boolean                         @default(true)
  createdAt DateTime                        @default(now())
  updatedAt DateTime                        @updatedAt

  @@index([personId])
  @@index([active])
}

// ----------------------------------------------------
// DISPOSITIVOS / TOTENS DE CAPTURA
// ----------------------------------------------------

model Device {
  id         String    @id @default(cuid())
  identifier String    @unique // ex: "TOTEM-ENTRADA-AUDITORIO"
  name       String    // ex: "Totem Principal 1"
  location   String?   // ex: "Hall do Auditório A"
  status     String    @default("ACTIVE")
  lastSeenAt DateTime?
  notes      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  presences  Presence[]
}

// ----------------------------------------------------
// DOMÍNIO DE EVENTOS & PRESENÇA
// ----------------------------------------------------

model Event {
  id                 String       @id @default(cuid())
  name               String       @default("Evento")
  slug               String       @unique
  description        String?
  date               DateTime?
  time               String?
  location           String?
  logoUrl            String?
  coverUrl           String?
  status             EventStatus  @default(DRAFT)
  primaryColor       String       @default("#002B49")
  secondaryColor     String       @default("#EAA023")
  allowRepeatWinners Boolean      @default(false)
  maxParticipants    Int?
  presentationToken  String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  participants EventParticipant[]
  prizes       Prize[]
  draws        Draw[]
  winners      Winner[]
  presences    Presence[]
  theme        EventTheme?
  soundConfig  SoundConfig?

  @@index([slug])
  @@index([status])
  @@index([presentationToken])
}

model EventParticipant {
  id           String            @id @default(cuid())
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId     String
  person       Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  ticketNumber Int               @default(1)
  category     String?
  status       ParticipantStatus @default(ACTIVE)
  isEligible   Boolean           @default(true)
  isWinner     Boolean           @default(false)
  registeredAt DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@unique([eventId, personId])
  @@index([eventId, ticketNumber])
  @@index([eventId])
  @@index([personId])
  @@index([eventId, isEligible])
}

model Presence {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId       String
  person         Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  method         PresenceMethod @default(FACE)
  confidence     Float?
  distance       Float?
  capturedAt     DateTime       @default(now())
  deviceId       String?
  device         Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  operatorUserId String?
  operatorUser   User?          @relation("PresenceOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  status         String         @default("REGISTERED")
  createdAt      DateTime       @default(now())

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
  @@index([capturedAt])
}

// ----------------------------------------------------
// PATROCINADORES, PRÊMIOS E SORTEIOS
// ----------------------------------------------------

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  description String?
  website     String?
  instagram   String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prizes Prize[]
}

model Prize {
  id             String      @id @default(cuid())
  eventId        String
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsorId      String?
  sponsor        Sponsor?    @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  imageUrl       String?
  quantity       Int         @default(1)
  estimatedValue Decimal?    @db.Decimal(10, 2)
  order          Int         @default(0)
  status         PrizeStatus @default(AVAILABLE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  draws   Draw[]
  winners Winner[]

  @@index([eventId])
  @@index([sponsorId])
  @@index([status])
}

model Draw {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizeId        String
  prize          Prize     @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  drawType       DrawType  @default(PERSON)
  winnerPersonId String?
  drawnNumber    Int?
  drawnName      String?
  operatorUserId String?
  operatorUser   User?     @relation("DrawOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  timestamp      DateTime  @default(now())
  notes          String?
  status         String    @default("COMPLETED")

  winners Winner[]

  @@index([eventId])
  @@index([prizeId])
}

model Winner {
  id                String    @id @default(cuid())
  eventId           String
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizeId           String
  prize             Prize     @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  personId          String
  person            Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  drawId            String
  draw              Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  drawDate          DateTime  @default(now())
  delivered         Boolean   @default(false)
  deliveredAt       DateTime?
  deliveryNotes     String?
  deliveredByUserId String?
  deliveredByUser   User?     @relation("PrizeDeliveryOperator", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([eventId])
  @@index([prizeId])
  @@index([personId])
  @@index([drawId])
}

model EventTheme {
  id                String   @id @default(cuid())
  eventId           String   @unique
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  heroTitle         String?
  heroSubtitle      String?
  backgroundPattern String   @default("modern-mesh")
  customCss         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SoundConfig {
  id           String   @id @default(cuid())
  eventId      String   @unique
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  soundEnabled Boolean  @default(true)
  volume       Float    @default(0.8)
  soundPreset  String   @default("institutional")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IdempotencyRecord {
  key       String   @id
  eventId   String
  result    String
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ----------------------------------------------------
// ESTRUTURA FÍSICA DO ARMÁRIO (ESTOQUE)
// ----------------------------------------------------

model Door {
  id          String    @id @default(cuid())
  code        String    @unique // ex: "PORTA-1", "PORTA-2", "PORTA-3"
  name        String    // ex: "Porta 1"
  description String?
  orderIndex  Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  boxes       Box[]
}

model Box {
  id          String    @id @default(cuid())
  doorId      String
  door        Door      @relation(fields: [doorId], references: [id], onDelete: Restrict)
  code        String    @unique // ex: "C001", "C017"
  name        String    // ex: "Caixa 017"
  description String?
  qrCodeUrl   String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inventories Inventory[]
  assets      Asset[]
  sourceMovements StockMovement[] @relation("SourceBox")
  destMovements   StockMovement[] @relation("DestBox")

  @@index([doorId])
  @@index([code])
}

// ----------------------------------------------------
// CATÁLOGO DE ITENS E ESTOQUE QUANTITATIVO
// ----------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String    @unique // ex: "Cabos", "Adaptadores", "Projetores"
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       Item[]
}

model Item {
  id                  String               @id @default(cuid())
  name                String               // ex: "Cabo HDMI 10m"
  sku                 String               @unique // Código interno / SKU
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  itemType            ItemType             @default(MATERIAL)
  logisticsType       ItemLogisticsType    @default(MOBILE_STOCK)
  unit                String               @default("UN") // UN, M, CX, PC
  description         String?
  minStock            Int                  @default(0)
  idealStock          Int                  @default(0)
  manufacturer        String?
  model               String?
  notes               String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  inventories         Inventory[]
  assets              Asset[]
  movements           StockMovement[]
  requestItems        RequestItem[]
  roomFixedEquipments RoomFixedEquipment[]
  reservations        Reservation[]

  @@index([categoryId])
  @@index([sku])
  @@index([name])
}

model Inventory {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  boxId       String
  box         Box       @relation(fields: [boxId], references: [id], onDelete: Restrict)
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, boxId])
  @@index([boxId])
  @@index([itemId])
}

// ----------------------------------------------------
// PATRIMÔNIO E EQUIPAMENTOS INDIVIDUAIS
// ----------------------------------------------------

model Asset {
  id               String       @id @default(cuid())
  itemId           String
  item             Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  assetTag         String       @unique // Número de Patrimônio (ex: "123456")
  serialNumber     String?      // Número de Série
  model            String?
  status           AssetStatus  @default(AVAILABLE)
  currentBoxId     String?      // Localização física atual (quando guardado no armário)
  currentBox       Box?         @relation(fields: [currentBoxId], references: [id], onDelete: SetNull)
  currentRoomId    String?      // Sala física atual (quando instalado fixo em sala de aula)
  currentRoom      Room?        @relation("RoomCurrentAssets", fields: [currentRoomId], references: [id], onDelete: SetNull)
  acquisitionDate  DateTime?
  acquisitionValue Decimal?     @db.Decimal(10, 2)
  notes            String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  loans                Loan[]
  maintenances         Maintenance[]
  history              AssetHistory[]
  requestItems         RequestItem[]
  roomFixedEquipments  RoomFixedEquipment[]
  reservations         Reservation[]

  @@index([assetTag])
  @@index([serialNumber])
  @@index([status])
  @@index([currentBoxId])
  @@index([currentRoomId])
}

model AssetHistory {
  id               String       @id @default(cuid())
  assetId          String
  asset            Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action           String       // ex: "CADASTRADO", "EMPRESTADO", "DEVOLVIDO", "MANUTENCAO", "REQUEST_ASSET_ALLOCATED", "REQUEST_ASSET_SWAP"
  fromStatus       AssetStatus?
  toStatus         AssetStatus
  fromLocation     String?
  toLocation       String?
  userId           String?
  userName         String?
  observation      String?
  createdAt        DateTime     @default(now())

  @@index([assetId])
}

// ----------------------------------------------------
// EMPRÉSTIMOS E DEVOLUÇÕES
// ----------------------------------------------------

model Loan {
  id                 String       @id @default(cuid())
  assetId            String
  asset              Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  borrowerName       String       // Nome do responsável (ex: "João Silva")
  borrowerEmail      String?
  borrowerPhone      String?
  borrowerDepartment String?      // ex: "Coordenação de Medicina", "Diretoria"
  destination        String       // ex: "Sala 203", "Auditório Principal"
  loanDate           DateTime     @default(now())
  expectedReturnDate DateTime     // Data prevista de devolução
  actualReturnDate   DateTime?    // Data real da devolução
  status             LoanStatus   @default(ACTIVE)
  notes              String?
  returnNotes        String?
  returnedCondition  String?      // ex: "Perfeito estado", "Cabo HDMI danificado"
  createdByUserId    String
  createdByUser      User         @relation("LoanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  receivedByUserId   String?
  receivedByUser     User?        @relation("LoanReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  returnBoxId        String?      // Caixa onde foi guardado na devolução
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([expectedReturnDate])
}

// ----------------------------------------------------
// MANUTENÇÃO DE EQUIPAMENTOS
// ----------------------------------------------------

model Maintenance {
  id                String            @id @default(cuid())
  orderNumber       String?           @unique // ex: "OS-2026-0001"
  assetId           String
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  issueDescription  String            // ex: "Lâmpada com defeito", "Sem sinal HDMI"
  maintenanceType   String?           @default("CORRECTIVE") // "CORRECTIVE", "PREVENTIVE", "EXTERNAL", "INTERNAL"
  priority          String?           @default("MEDIUM")     // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  entryDate         DateTime          @default(now())
  exitDate          DateTime?
  status            MaintenanceStatus @default(IN_PROGRESS)
  serviceProvider   String?           // Técnico / Empresa responsável
  cost              Decimal?          @db.Decimal(10, 2)
  diagnosis         String?           // Diagnóstico preliminar / laudo de entrada
  solution          String?           // Solução técnica aplicada / reparo efetuado
  technicalNotes    String?           // Laudo / Solução aplicada / observações gerais
  replacedParts     String?           // Peças ou componentes substituídos (ex: Lâmpada ELPLP96)
  lampHours         Int?              // Horímetro da lâmpada trocada (se aplicável)
  contactName       String?           // Nome do contato na assistência ou solicitante
  contactPhone      String?           // WhatsApp / Telefone para contato
  createdByUserId   String
  createdByUser     User              @relation("MaintenanceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedByUserId String?
  completedByUser   User?             @relation("MaintenanceCloser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([orderNumber])
}

// ----------------------------------------------------
// MOVIMENTAÇÕES DE ESTOQUE (HISTÓRICO INALTERÁVEL)
// ----------------------------------------------------

model StockMovement {
  id              String       @id @default(cuid())
  type            MovementType
  itemId          String
  item            Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceBoxId     String?
  sourceBox       Box?         @relation("SourceBox", fields: [sourceBoxId], references: [id], onDelete: SetNull)
  destBoxId       String?
  destBox         Box?         @relation("DestBox", fields: [destBoxId], references: [id], onDelete: SetNull)
  quantity        Int
  balanceBefore   Int
  balanceAfter    Int
  observation     String?
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

// ----------------------------------------------------
// AUDITORIA DO SISTEMA
// ----------------------------------------------------

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String    // ex: "LOGIN", "CREATE_ITEM", "FACE_ENROLL", "DRAW_EXECUTE", etc.
  entity      String    // ex: "Item", "Asset", "Loan", "Person", "Event", "Prize", "Draw", "Presence"
  entityId    String?
  details     Json?     // Payload com detalhes das operações
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------
// AGENDA OPERACIONAL POR TURNOS & GESTÃO DE SALAS
// ----------------------------------------------------

model ShiftConfig {
  id         String   @id @default(cuid())
  shift      Shift    @unique
  startTime  String   // Formato "HH:mm" (ex: "07:00")
  endTime    String   // Formato "HH:mm" (ex: "12:00")
  label      String   // ex: "Manhã"
  emoji      String?  // ex: "🌅"
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Room {
  id                   String               @id @default(cuid())
  name                 String               @unique // ex: "1A", "LAB 2A", "SIMU 1B"
  floor                String?              // ex: "1 Andar", "TÉRREO"
  block                String?
  active               Boolean              @default(true)

  // Projetor fixo instalado na sala
  fixedProjectorModel  String?              // ex: "Epson s41+"
  vgaCableOk           Boolean?
  hdmiCableOk          Boolean?
  lampHours            Int?
  lampStatus           String?              // ex: "Bom" | "TROCAR LAMPADA"
  lastVisitAt          DateTime?

  // Equipamentos fixos dinâmicos adicionais
  fixedEquipment       RoomFixedEquipment[]
  currentAssets        Asset[]              @relation("RoomCurrentAssets")
  requests             Request[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([name])
  @@index([floor])
  @@index([active])
}

model RoomFixedEquipment {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  itemId    String?  // Opcional: vínculo ao catálogo
  item      Item?    @relation(fields: [itemId], references: [id])
  assetId   String?  // Vínculo ao Patrimônio do TI (Asset)
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  label     String   // ex: "Projetor Epson PowerLite", "TV 55 pol", "PC"
  status    String?  // ex: "OK", "Com defeito", "Em Manutenção"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([assetId])
}

// ----------------------------------------------------
// AGENDAMENTOS OPERACIONAIS (MULTIMÍDIA)
// ----------------------------------------------------

model Request {
  id               String          @id @default(cuid())
  date             DateTime        // Data da realização do atendimento
  startTime        DateTime        // Data e hora real de início
  endTime          DateTime        // Data e hora real de término
  shift            Shift           // Calculado automaticamente pelo ShiftService
  isOutsideShift   Boolean         @default(false) // Marcador se o atendimento está fora do expediente regular
  priority         RequestPriority @default(NORMAL)
  roomId           String
  room             Room            @relation(fields: [roomId], references: [id])
  professorName    String?
  discipline       String?
  attendanceType   String?
  notes            String?
  status           RequestStatus   @default(AGENDADO)
  origin           RequestOrigin   @default(MANUAL)
  needsReview      Boolean         @default(false)

  assignedUserId   String?
  assignedUser     User?           @relation("RequestAssignedUser", fields: [assignedUserId], references: [id])
  createdById      String
  createdBy        User            @relation("RequestCreatedBy", fields: [createdById], references: [id])

  // Recorrência
  seriesId         String?
  series           RequestSeries?  @relation(fields: [seriesId], references: [id])

  items            RequestItem[]
  reservations     Reservation[]
  tasks            RequestTask[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([date])
  @@index([shift])
  @@index([status])
  @@index([roomId])
  @@index([assignedUserId])
  @@index([seriesId])
}

model RequestItem {
  id           String        @id @default(cuid())
  requestId    String
  request      Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId       String?
  item         Item?         @relation(fields: [itemId], references: [id])
  assetId      String?       // Patrimônio físico específico alocado pelo Multimídia
  asset        Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  resourceType ResourceType  @default(QUANTITATIVE)
  label        String        // Descrição do recurso solicitado (ex: "Notebook", "Cabo HDMI 10m", "Datashow da sala")
  quantity     Int           @default(1)
  separated    Boolean       @default(false)
  notes        String?

  @@index([assetId])
  @@index([requestId])
  @@index([itemId])
}

model Reservation {
  id           String            @id @default(cuid())
  requestId    String
  request      Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId       String?           // Vínculo com catálogo de itens
  item         Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  assetId      String?           // Vínculo com patrimônio específico (quando alocado)
  asset        Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  resourceType ResourceType      @default(QUANTITATIVE)
  quantity     Int               @default(1)
  startTime    DateTime
  endTime      DateTime
  status       ReservationStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([requestId])
  @@index([itemId])
  @@index([assetId])
  @@index([startTime, endTime])
  @@index([status])
}

model RequestTask {
  id                String    @id @default(cuid())
  requestId         String
  request           Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title             String    // ex: "Ligar Datashow da Sala 2N", "Separar 1 Notebook"
  description       String?
  taskType          TaskType  @default(SEPARATION)
  completed         Boolean   @default(false)
  completedAt       DateTime?
  completedByUserId String?
  completedByUser   User?     @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)
  orderIndex        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([requestId])
  @@index([completed])
  @@index([taskType])
}

model RequestSeries {
  id          String    @id @default(cuid())
  frequency   String    // "WEEKLY"
  dayOfWeek   Int?      // 0-6 (0 = Domingo, 1 = Segunda...)
  startDate   DateTime
  endDate     DateTime?
  requests    Request[]
  createdAt   DateTime  @default(now())
}
