# ==============================================================================
# UNIFAP MULTIMÍDIA — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL 16 com pgvector
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=unifap_secure_password_2026
POSTGRES_DB=estoque_multimidia
DATABASE_URL=postgresql://postgres:unifap_secure_password_2026@localhost:5432/estoque_multimidia

# ------------------------------------------------------------------------------
# Autenticação e Segurança (NextAuth.js)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=unifap_nextauth_super_secret_jwt_key_2026_change_in_production

# ------------------------------------------------------------------------------
# Microsserviço de Biometria Facial (FastAPI)
# ------------------------------------------------------------------------------
# URL interna acessada pelo Next.js (http://localhost:8000 local, http://biometric-api:8000 no Docker)
BIOMETRIC_API_URL=http://localhost:8000
# Token secreto de autenticação mútua interna entre Next.js e FastAPI
BIOMETRIC_INTERNAL_TOKEN=unifap_biometric_secret_token_2026_internal_only
# Limiar padrão de tolerância para distância Euclidiana L2 no pgvector (padrão: 0.60)
RECOGNITION_TOLERANCE=0.60

# ------------------------------------------------------------------------------
# Cloudflare Tunnel (Produção Segura sem abertura de portas públicas)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2Vu...
