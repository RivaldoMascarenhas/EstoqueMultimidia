# UniFAP - Suporte de TI & Estoque
# Variáveis de Ambiente de Exemplo (NUNCA utilize estes valores em produção!)

# Banco de Dados PostgreSQL (Local ou Docker)
DATABASE_URL="postgresql://postgres:unifap_secure_password_2026@localhost:5432/unifap_estoque?schema=public"

# NextAuth.js (OBRIGATÓRIO: gere um segredo único via `openssl rand -base64 32`)
