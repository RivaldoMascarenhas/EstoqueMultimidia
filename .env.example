# ==============================================================================
# UNIFAP MULTIMÍDIA — VARIÁVEIS DE AMBIENTE RECOMENDADAS (.env)
# ==============================================================================
# IMPORTANTE: Gere segredos fortes e aleatórios antes de iniciar em produção:
# Exemplo Linux/Mac/WSL: openssl rand -base64 32
# Exemplo PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL 16 com pgvector
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_do_postgres_aqui
POSTGRES_DB=estoque_multimidia
# No Docker Compose local: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# No desenvolvimento local: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://postgres:sua_senha_segura_do_postgres_aqui@localhost:5432/estoque_multimidia

# ------------------------------------------------------------------------------
# 2. Autenticação e URLs Públicas (NextAuth.js & Cloudflare)
# ------------------------------------------------------------------------------
# --- REDIS (Rate Limiting Distribuído & Cache de Sessão) ---
REDIS_PASSWORD="coloque_uma_senha_forte_para_o_redis_aqui"
REDIS_URL="redis://:coloque_uma_senha_forte_para_o_redis_aqui@redis:6379"

# URL pública oficial (Ex: https://estoque.fapce.edu.br ou http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chave mestra de assinatura dos tokens JWT (OBRIGATÓRIO: openssl rand -base64 32)
NEXTAUTH_SECRET=gere_uma_chave_jwt_super_secreta_com_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# 3. Inicialização e Senha Padrão de Seed (Primeiro Acesso)
# ------------------------------------------------------------------------------
# Senha provisória atribuída aos usuários no seed inicial caso o banco esteja vazio.
# No primeiro login, o sistema exigirá obrigatoriamente a troca de senha (mustChangePassword: true).
SEED_DEFAULT_PASSWORD=DefinaSuaSenhaSeguraProvisoria123!

# Definir como 'false' para iniciar o banco LIMPO (Zero dados mocados / sem empréstimos/eventos fake)
# Apenas a estrutura (Portas/Caixas do Armário, Salas reais, Categorias e Usuários Admin) será criada.
# Definir como 'true' caso queira carregar os dados de demonstração para testes.
SEED_MOCK_DATA=false

# ------------------------------------------------------------------------------
# 4. Microsserviço de Biometria Facial (FastAPI + pgvector)
# ------------------------------------------------------------------------------
# URL interna (http://localhost:8000 local, http://biometric-api:8000 no Docker)
BIOMETRIC_API_URL=http://localhost:8000
# Token secreto de autenticação mútua interna entre Next.js e FastAPI
BIOMETRIC_INTERNAL_TOKEN=gere_um_token_interno_aleatorio_openssl_rand_base64_32
# Limiar padrão de tolerância para distância Euclidiana L2 no pgvector (padrão: 0.60)
FACE_DISTANCE_THRESHOLD=0.60
MIN_CONFIDENCE_THRESHOLD=0.80

# ------------------------------------------------------------------------------
# 5. Cloudflare Tunnel (Zero Trust - Produção Segura)
# Obtenha o token no painel Cloudflare Zero Trust -> Networks -> Tunnels
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2Vu...
